# FlightPlan environment template.
# NOT REQUIRED for the demo: compose.yaml has these same defaults inline.
# Copy to `.env` only to override. Every value here is DEMO-ONLY — never use in production.

# --- Database (Postgres runs on the internal compose network only; no host port) ---
POSTGRES_PASSWORD=demo_only_change_me
# Must match POSTGRES_PASSWORD above.
DATABASE_URL=postgresql+psycopg://flightplan:demo_only_change_me@db:5432/flightplan

# --- Backend (FastAPI) ---
# Pepper for hashing opaque session tokens. Replace with a long random secret outside the demo.
AUTH_SECRET=demo_secret_replace_for_production
FLIGHTPLAN_DEMO_MODE=true
# Password for the seeded demo accounts (family@ / clinician@flightplan.demo).
DEMO_PASSWORD=FlightPlanDemo1!
# Fixed "now" used by the demo timeline.
DEMO_AS_OF=2026-10-23T15:00:00Z
# Only `mock` is implemented; a FHIR adapter is a stub.
CLINICAL_DATA_PROVIDER=mock
ENABLE_MYCHART_LOGIN=false
ENABLE_EPIC_LAUNCH=false
SESSION_TTL_HOURS=12

# --- Frontend (Next.js BFF) ---
# Server-side only. In compose this is always http://api:8080; use http://localhost:8080 when
# running `npm run dev` on the host.
BACKEND_URL=http://localhost:8080
# Shows the Demo badge + demo credentials hint. Also baked in at image build time.
NEXT_PUBLIC_DEMO_MODE=true
# Set true only when served over HTTPS (marks the fp_session cookie Secure).
COOKIE_SECURE=false
